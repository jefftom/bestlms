{
  "id": "corporate-professional",
  "name": "Corporate Professional",
  "description": "Clean business style perfect for corporate training",
  "category": "business",
  "size": {
    "width": 792,
    "height": 612,
    "unit": "pt"
  },
  "orientation": "landscape",
  "background": {
    "type": "color",
    "value": "#ffffff"
  },
  "customizable": {
    "primaryColor": "#1e3a5f",
    "secondaryColor": "#64748b",
    "accentColor": "#0ea5e9",
    "titleFont": "Montserrat",
    "bodyFont": "Open Sans",
    "nameFont": "Montserrat"
  },
  "elements": [
    {
      "id": "header-bar",
      "type": "shape",
      "shape": "rectangle",
      "x": 0,
      "y": 0,
      "width": 792,
      "height": 80,
      "fill": "{primaryColor}"
    },
    {
      "id": "header-accent",
      "type": "shape",
      "shape": "rectangle",
      "x": 0,
      "y": 80,
      "width": 792,
      "height": 4,
      "fill": "{accentColor}"
    },
    {
      "id": "logo-placeholder",
      "type": "image_placeholder",
      "placeholder": "logo",
      "x": 50,
      "y": 20,
      "width": 120,
      "height": 40,
      "description": "Company Logo"
    },
    {
      "id": "header-title",
      "type": "text",
      "content": "CERTIFICATE OF COMPLETION",
      "x": 450,
      "y": 32,
      "width": 400,
      "fontSize": 18,
      "fontFamily": "{titleFont}",
      "fontWeight": "bold",
      "fill": "#ffffff",
      "align": "center",
      "letterSpacing": 3
    },
    {
      "id": "presented-to",
      "type": "text",
      "content": "THIS CERTIFICATE IS AWARDED TO",
      "x": 396,
      "y": 130,
      "width": 500,
      "fontSize": 11,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 3
    },
    {
      "id": "student-name",
      "type": "dynamic_field",
      "field": "student_name",
      "x": 396,
      "y": 180,
      "width": 650,
      "fontSize": 42,
      "fontFamily": "{nameFont}",
      "fontWeight": "bold",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "name-underline",
      "type": "shape",
      "shape": "line",
      "x": 146,
      "y": 225,
      "width": 500,
      "height": 2,
      "fill": "{accentColor}"
    },
    {
      "id": "for-text",
      "type": "text",
      "content": "FOR SUCCESSFULLY COMPLETING",
      "x": 396,
      "y": 260,
      "width": 500,
      "fontSize": 11,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 3
    },
    {
      "id": "course-title",
      "type": "dynamic_field",
      "field": "course_title",
      "x": 396,
      "y": 300,
      "width": 650,
      "fontSize": 28,
      "fontFamily": "{titleFont}",
      "fontWeight": "600",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "course-hours",
      "type": "dynamic_field",
      "field": "course_hours",
      "x": 396,
      "y": 350,
      "width": 300,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center",
      "prefix": "Duration: ",
      "suffix": " hours"
    },
    {
      "id": "date-box",
      "type": "shape",
      "shape": "rectangle",
      "x": 100,
      "y": 420,
      "width": 180,
      "height": 80,
      "fill": "#f8fafc",
      "stroke": "#e2e8f0",
      "strokeWidth": 1
    },
    {
      "id": "date-label",
      "type": "text",
      "content": "DATE COMPLETED",
      "x": 190,
      "y": 435,
      "width": 160,
      "fontSize": 9,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 1
    },
    {
      "id": "completion-date",
      "type": "dynamic_field",
      "field": "completion_date",
      "x": 190,
      "y": 465,
      "width": 160,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "signature-box",
      "type": "shape",
      "shape": "rectangle",
      "x": 306,
      "y": 420,
      "width": 180,
      "height": 80,
      "fill": "#f8fafc",
      "stroke": "#e2e8f0",
      "strokeWidth": 1
    },
    {
      "id": "signature-label",
      "type": "text",
      "content": "AUTHORIZED BY",
      "x": 396,
      "y": 435,
      "width": 160,
      "fontSize": 9,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 1
    },
    {
      "id": "instructor-name",
      "type": "dynamic_field",
      "field": "instructor_name",
      "x": 396,
      "y": 465,
      "width": 160,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "cert-box",
      "type": "shape",
      "shape": "rectangle",
      "x": 512,
      "y": 420,
      "width": 180,
      "height": 80,
      "fill": "#f8fafc",
      "stroke": "#e2e8f0",
      "strokeWidth": 1
    },
    {
      "id": "cert-label",
      "type": "text",
      "content": "CERTIFICATE ID",
      "x": 602,
      "y": 435,
      "width": 160,
      "fontSize": 9,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 1
    },
    {
      "id": "cert-id",
      "type": "dynamic_field",
      "field": "certificate_id",
      "x": 602,
      "y": 465,
      "width": 160,
      "fontSize": 12,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "footer-bar",
      "type": "shape",
      "shape": "rectangle",
      "x": 0,
      "y": 560,
      "width": 792,
      "height": 52,
      "fill": "#f8fafc"
    },
    {
      "id": "qr-code",
      "type": "qr_code",
      "field": "certificate_url",
      "x": 730,
      "y": 566,
      "size": 40,
      "foreground": "{primaryColor}",
      "background": "#f8fafc"
    },
    {
      "id": "verify-text",
      "type": "text",
      "content": "Scan to verify authenticity",
      "x": 655,
      "y": 580,
      "width": 100,
      "fontSize": 8,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "right"
    }
  ]
}
