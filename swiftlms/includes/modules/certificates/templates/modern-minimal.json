{
  "id": "modern-minimal",
  "name": "Modern Minimal",
  "description": "Clean, contemporary design with plenty of white space",
  "category": "modern",
  "size": {
    "width": 792,
    "height": 612,
    "unit": "pt"
  },
  "orientation": "landscape",
  "background": {
    "type": "color",
    "value": "#ffffff"
  },
  "customizable": {
    "primaryColor": "#1a1a1a",
    "secondaryColor": "#666666",
    "accentColor": "#0073aa",
    "titleFont": "Playfair Display",
    "bodyFont": "Open Sans",
    "nameFont": "Great Vibes"
  },
  "elements": [
    {
      "id": "accent-line-top",
      "type": "shape",
      "shape": "line",
      "x": 100,
      "y": 60,
      "width": 592,
      "height": 2,
      "fill": "{accentColor}",
      "locked": false
    },
    {
      "id": "title",
      "type": "text",
      "content": "Certificate of Completion",
      "x": 396,
      "y": 100,
      "width": 600,
      "fontSize": 38,
      "fontFamily": "{titleFont}",
      "fontWeight": "bold",
      "fill": "{primaryColor}",
      "align": "center",
      "editable": true
    },
    {
      "id": "subtitle",
      "type": "text",
      "content": "This is to certify that",
      "x": 396,
      "y": 170,
      "width": 500,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fontWeight": "normal",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 2,
      "textTransform": "uppercase",
      "editable": true
    },
    {
      "id": "student-name",
      "type": "dynamic_field",
      "field": "student_name",
      "x": 396,
      "y": 220,
      "width": 600,
      "fontSize": 48,
      "fontFamily": "{nameFont}",
      "fontWeight": "normal",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "completion-text",
      "type": "text",
      "content": "has successfully completed",
      "x": 396,
      "y": 290,
      "width": 500,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fontWeight": "normal",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 2,
      "textTransform": "uppercase",
      "editable": true
    },
    {
      "id": "course-title",
      "type": "dynamic_field",
      "field": "course_title",
      "x": 396,
      "y": 340,
      "width": 600,
      "fontSize": 28,
      "fontFamily": "{titleFont}",
      "fontWeight": "bold",
      "fill": "{accentColor}",
      "align": "center"
    },
    {
      "id": "date-label",
      "type": "text",
      "content": "Completed on",
      "x": 200,
      "y": 450,
      "width": 200,
      "fontSize": 11,
      "fontFamily": "{bodyFont}",
      "fontWeight": "normal",
      "fill": "{secondaryColor}",
      "align": "center",
      "textTransform": "uppercase",
      "letterSpacing": 1
    },
    {
      "id": "completion-date",
      "type": "dynamic_field",
      "field": "completion_date",
      "x": 200,
      "y": 470,
      "width": 200,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "signature-line",
      "type": "shape",
      "shape": "line",
      "x": 492,
      "y": 480,
      "width": 200,
      "height": 1,
      "fill": "{secondaryColor}"
    },
    {
      "id": "signature-label",
      "type": "text",
      "content": "Instructor",
      "x": 592,
      "y": 490,
      "width": 200,
      "fontSize": 11,
      "fontFamily": "{bodyFont}",
      "fontWeight": "normal",
      "fill": "{secondaryColor}",
      "align": "center",
      "textTransform": "uppercase",
      "letterSpacing": 1
    },
    {
      "id": "instructor-name",
      "type": "dynamic_field",
      "field": "instructor_name",
      "x": 592,
      "y": 460,
      "width": 200,
      "fontSize": 14,
      "fontFamily": "{nameFont}",
      "fontWeight": "normal",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "cert-id",
      "type": "dynamic_field",
      "field": "certificate_id",
      "x": 396,
      "y": 550,
      "width": 300,
      "fontSize": 10,
      "fontFamily": "{bodyFont}",
      "fontWeight": "normal",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "accent-line-bottom",
      "type": "shape",
      "shape": "line",
      "x": 100,
      "y": 570,
      "width": 592,
      "height": 2,
      "fill": "{accentColor}",
      "locked": false
    },
    {
      "id": "qr-code",
      "type": "qr_code",
      "field": "certificate_url",
      "x": 720,
      "y": 520,
      "size": 60,
      "foreground": "{primaryColor}",
      "background": "#ffffff"
    }
  ]
}
