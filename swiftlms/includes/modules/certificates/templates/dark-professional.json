{
  "id": "dark-professional",
  "name": "Dark Professional",
  "description": "Sleek dark theme with modern typography",
  "category": "modern",
  "size": {
    "width": 792,
    "height": 612,
    "unit": "pt"
  },
  "orientation": "landscape",
  "background": {
    "type": "color",
    "value": "#0f0f0f"
  },
  "customizable": {
    "primaryColor": "#ffffff",
    "secondaryColor": "#a1a1aa",
    "accentColor": "#3b82f6",
    "titleFont": "Space Grotesk",
    "bodyFont": "Inter",
    "nameFont": "Space Grotesk"
  },
  "elements": [
    {
      "id": "bg",
      "type": "shape",
      "shape": "rectangle",
      "x": 0,
      "y": 0,
      "width": 792,
      "height": 612,
      "fill": "#0f0f0f"
    },
    {
      "id": "accent-line-top",
      "type": "shape",
      "shape": "line",
      "x": 50,
      "y": 50,
      "width": 100,
      "height": 3,
      "fill": "{accentColor}"
    },
    {
      "id": "certificate-label",
      "type": "text",
      "content": "CERTIFICATE",
      "x": 100,
      "y": 80,
      "width": 200,
      "fontSize": 12,
      "fontFamily": "{bodyFont}",
      "fontWeight": "500",
      "fill": "{secondaryColor}",
      "align": "left",
      "letterSpacing": 4
    },
    {
      "id": "cert-number",
      "type": "dynamic_field",
      "field": "certificate_id",
      "x": 692,
      "y": 80,
      "width": 150,
      "fontSize": 11,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "right"
    },
    {
      "id": "main-title",
      "type": "text",
      "content": "Certificate of",
      "x": 396,
      "y": 150,
      "width": 600,
      "fontSize": 24,
      "fontFamily": "{titleFont}",
      "fontWeight": "300",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "completion-title",
      "type": "text",
      "content": "Completion",
      "x": 396,
      "y": 185,
      "width": 600,
      "fontSize": 56,
      "fontFamily": "{titleFont}",
      "fontWeight": "bold",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "awarded-to",
      "type": "text",
      "content": "Awarded to",
      "x": 396,
      "y": 270,
      "width": 300,
      "fontSize": 12,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 2,
      "textTransform": "uppercase"
    },
    {
      "id": "student-name",
      "type": "dynamic_field",
      "field": "student_name",
      "x": 396,
      "y": 310,
      "width": 650,
      "fontSize": 38,
      "fontFamily": "{nameFont}",
      "fontWeight": "bold",
      "fill": "{accentColor}",
      "align": "center"
    },
    {
      "id": "for-completing",
      "type": "text",
      "content": "for completing",
      "x": 396,
      "y": 375,
      "width": 300,
      "fontSize": 12,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 2,
      "textTransform": "uppercase"
    },
    {
      "id": "course-title",
      "type": "dynamic_field",
      "field": "course_title",
      "x": 396,
      "y": 410,
      "width": 600,
      "fontSize": 24,
      "fontFamily": "{titleFont}",
      "fontWeight": "500",
      "fill": "{primaryColor}",
      "align": "center"
    },
