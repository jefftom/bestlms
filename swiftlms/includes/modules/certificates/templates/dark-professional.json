      "x": 316,
      "y": 495,
      "width": 160,
      "height": 60,
      "fill": "#18181b",
      "borderRadius": 4
    },
    {
      "id": "instructor-label",
      "type": "text",
      "content": "INSTRUCTOR",
      "x": 396,
      "y": 505,
      "width": 140,
      "fontSize": 9,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 2
    },
    {
      "id": "instructor-name",
      "type": "dynamic_field",
      "field": "instructor_name",
      "x": 396,
      "y": 528,
      "width": 140,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "hours-block",
      "type": "shape",
      "shape": "rectangle",
      "x": 482,
      "y": 495,
      "width": 160,
      "height": 60,
      "fill": "#18181b",
      "borderRadius": 4
    },
    {
      "id": "hours-label",
      "type": "text",
      "content": "DURATION",
      "x": 562,
      "y": 505,
      "width": 140,
      "fontSize": 9,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 2
    },
    {
      "id": "course-hours",
      "type": "dynamic_field",
      "field": "course_hours",
      "x": 562,
