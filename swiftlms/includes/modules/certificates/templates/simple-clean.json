{
  "id": "simple-clean",
  "name": "Simple Clean",
  "description": "Minimalist design focusing on content",
  "category": "minimal",
  "size": {
    "width": 792,
    "height": 612,
    "unit": "pt"
  },
  "orientation": "landscape",
  "background": {
    "type": "color",
    "value": "#ffffff"
  },
  "customizable": {
    "primaryColor": "#18181b",
    "secondaryColor": "#71717a",
    "accentColor": "#18181b",
    "titleFont": "Libre Franklin",
    "bodyFont": "Libre Franklin",
    "nameFont": "Libre Franklin"
  },
  "elements": [
    {
      "id": "border",
      "type": "shape",
      "shape": "rectangle",
      "x": 40,
      "y": 40,
      "width": 712,
      "height": 532,
      "fill": "transparent",
      "stroke": "#e4e4e7",
      "strokeWidth": 1
    },
    {
      "id": "title",
      "type": "text",
      "content": "CERTIFICATE OF COMPLETION",
      "x": 396,
      "y": 100,
      "width": 600,
      "fontSize": 24,
      "fontFamily": "{titleFont}",
      "fontWeight": "600",
      "fill": "{primaryColor}",
      "align": "center",
      "letterSpacing": 6
    },
    {
      "id": "divider-top",
      "type": "shape",
      "shape": "line",
      "x": 296,
      "y": 145,
      "width": 200,
      "height": 1,
      "fill": "{primaryColor}"
    },
    {
      "id": "this-certifies",
      "type": "text",
      "content": "This certifies that",
      "x": 396,
      "y": 180,
      "width": 400,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "student-name",
