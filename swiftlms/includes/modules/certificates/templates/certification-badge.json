{
  "id": "certification-badge",
  "name": "Certification Badge",
  "description": "Professional certification with prominent badge seal",
  "category": "certification",
  "size": {
    "width": 792,
    "height": 612,
    "unit": "pt"
  },
  "orientation": "landscape",
  "background": {
    "type": "color",
    "value": "#f8fafc"
  },
  "customizable": {
    "primaryColor": "#0f172a",
    "secondaryColor": "#64748b",
    "accentColor": "#0891b2",
    "titleFont": "DM Sans",
    "bodyFont": "DM Sans",
    "nameFont": "DM Sans"
  },
  "elements": [
    {
      "id": "left-panel",
      "type": "shape",
      "shape": "rectangle",
      "x": 0,
      "y": 0,
      "width": 260,
      "height": 612,
      "fill": "{primaryColor}"
    },
    {
      "id": "badge-outer",
      "type": "shape",
      "shape": "circle",
      "x": 55,
      "y": 180,
      "width": 150,
      "height": 150,
      "fill": "{accentColor}"
    },
    {
      "id": "badge-inner",
      "type": "shape",
      "shape": "circle",
      "x": 65,
      "y": 190,
      "width": 130,
      "height": 130,
      "fill": "{primaryColor}",
      "stroke": "{accentColor}",
      "strokeWidth": 3
    },
    {
      "id": "badge-text-1",
      "type": "text",
      "content": "CERTIFIED",
      "x": 130,
      "y": 240,
      "width": 100,
      "fontSize": 11,
      "fontFamily": "{titleFont}",
      "fontWeight": "bold",
      "fill": "#ffffff",
      "align": "center",
      "letterSpacing": 2
    },
    {
      "id": "badge-checkmark",
      "type": "text",
      "content": "✓",
      "x": 130,
      "y": 265,
      "fontSize": 28,
      "fontFamily": "sans-serif",
      "fontWeight": "bold",
      "fill": "{accentColor}",
      "align": "center"
    },
    {
      "id": "sidebar-title",
      "type": "text",
      "content": "PROFESSIONAL",
      "x": 130,
      "y": 400,
      "width": 200,
      "fontSize": 10,
      "fontFamily": "{titleFont}",
      "fontWeight": "bold",
      "fill": "{accentColor}",
      "align": "center",
      "letterSpacing": 3
    },
    {
      "id": "sidebar-cert",
      "type": "text",
      "content": "CERTIFICATION",
      "x": 130,
      "y": 420,
      "width": 200,
      "fontSize": 10,
      "fontFamily": "{titleFont}",
      "fontWeight": "bold",
      "fill": "#ffffff",
      "align": "center",
      "letterSpacing": 3
    },
    {
      "id": "cert-id-sidebar",
      "type": "dynamic_field",
      "field": "certificate_id",
      "x": 130,
      "y": 560,
      "width": 200,
      "fontSize": 9,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "main-title",
      "type": "text",
      "content": "Certificate of Certification",
      "x": 526,
      "y": 80,
      "width": 450,
      "fontSize": 34,
      "fontFamily": "{titleFont}",
      "fontWeight": "bold",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "this-certifies",
      "type": "text",
      "content": "This is to certify that",
      "x": 526,
      "y": 140,
      "width": 400,
      "fontSize": 13,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "student-name",
      "type": "dynamic_field",
      "field": "student_name",
      "x": 526,
      "y": 185,
      "width": 450,
      "fontSize": 36,
      "fontFamily": "{nameFont}",
      "fontWeight": "bold",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "has-demonstrated",
      "type": "text",
      "content": "has successfully demonstrated proficiency in",
      "x": 526,
      "y": 245,
      "width": 400,
      "fontSize": 13,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "course-title",
      "type": "dynamic_field",
      "field": "course_title",
      "x": 526,
      "y": 285,
      "width": 450,
      "fontSize": 24,
      "fontFamily": "{titleFont}",
      "fontWeight": "600",
      "fill": "{accentColor}",
      "align": "center"
    },
    {
      "id": "and-is-awarded",
      "type": "text",
      "content": "and is hereby awarded this certification",
      "x": 526,
      "y": 335,
      "width": 400,
      "fontSize": 13,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "divider",
      "type": "shape",
      "shape": "line",
      "x": 350,
      "y": 380,
      "width": 352,
      "height": 1,
      "fill": "#e2e8f0"
    },
    {
      "id": "issued-label",
      "type": "text",
      "content": "ISSUED",
      "x": 410,
      "y": 420,
      "width": 100,
      "fontSize": 10,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 1
    },
    {
      "id": "completion-date",
      "type": "dynamic_field",
      "field": "completion_date",
      "x": 410,
      "y": 440,
      "width": 100,
      "fontSize": 13,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "expires-label",
      "type": "text",
      "content": "EXPIRES",
      "x": 526,
      "y": 420,
      "width": 100,
      "fontSize": 10,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 1
    },
    {
      "id": "expiration-date",
      "type": "dynamic_field",
      "field": "expiration_date",
      "x": 526,
      "y": 440,
      "width": 100,
      "fontSize": 13,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{primaryColor}",
      "align": "center",
      "fallback": "Never"
    },
    {
      "id": "credits-label",
      "type": "text",
      "content": "CREDITS",
      "x": 642,
      "y": 420,
      "width": 100,
      "fontSize": 10,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 1
    },
    {
      "id": "course-credits",
      "type": "dynamic_field",
      "field": "course_credits",
      "x": 642,
      "y": 440,
      "width": 100,
      "fontSize": 13,
      "fontFamily": "{bodyFont}",
      "fontWeight": "600",
      "fill": "{primaryColor}",
      "align": "center",
      "suffix": " CEU",
      "fallback": "N/A"
    },
    {
      "id": "sig-line",
      "type": "shape",
      "shape": "line",
      "x": 350,
      "y": 530,
      "width": 150,
      "height": 1,
      "fill": "{secondaryColor}"
    },
    {
      "id": "instructor-name",
      "type": "dynamic_field",
      "field": "instructor_name",
      "x": 425,
      "y": 505,
      "width": 150,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "instructor-label",
      "type": "text",
      "content": "Certifying Authority",
      "x": 425,
      "y": 540,
      "width": 150,
      "fontSize": 10,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "qr-code",
      "type": "qr_code",
      "field": "certificate_url",
      "x": 650,
      "y": 495,
      "size": 60,
      "foreground": "{primaryColor}",
      "background": "#f8fafc"
    },
    {
      "id": "verify-label",
      "type": "text",
      "content": "Scan to verify",
      "x": 680,
      "y": 560,
      "width": 60,
      "fontSize": 8,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center"
    }
  ]
}
