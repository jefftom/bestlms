{
  "id": "training-completion",
  "name": "Training Completion",
  "description": "Simple, professional certificate for training programs",
  "category": "training",
  "size": {
    "width": 792,
    "height": 612,
    "unit": "pt"
  },
  "orientation": "landscape",
  "background": {
    "type": "color",
    "value": "#ffffff"
  },
  "customizable": {
    "primaryColor": "#111827",
    "secondaryColor": "#6b7280",
    "accentColor": "#059669",
    "titleFont": "Roboto",
    "bodyFont": "Roboto",
    "nameFont": "Roboto"
  },
  "elements": [
    {
      "id": "top-bar",
      "type": "shape",
      "shape": "rectangle",
      "x": 0,
      "y": 0,
      "width": 792,
      "height": 12,
      "fill": "{accentColor}"
    },
    {
      "id": "logo-placeholder",
      "type": "image_placeholder",
      "placeholder": "logo",
      "x": 60,
      "y": 50,
      "width": 140,
      "height": 50,
      "description": "Organization Logo"
    },
    {
      "id": "training-badge",
      "type": "shape",
      "shape": "circle",
      "x": 660,
      "y": 40,
      "width": 70,
      "height": 70,
      "fill": "{accentColor}"
    },
    {
      "id": "badge-check",
      "type": "text",
      "content": "✓",
      "x": 695,
      "y": 65,
      "fontSize": 32,
      "fontFamily": "sans-serif",
      "fontWeight": "bold",
      "fill": "#ffffff",
      "align": "center"
    },
    {
      "id": "title",
      "type": "text",
      "content": "Training Completion Certificate",
      "x": 396,
      "y": 100,
      "width": 500,
      "fontSize": 32,
      "fontFamily": "{titleFont}",
      "fontWeight": "bold",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "this-certifies",
      "type": "text",
      "content": "This is to certify that",
      "x": 396,
      "y": 165,
      "width": 400,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "student-name",
      "type": "dynamic_field",
      "field": "student_name",
      "x": 396,
      "y": 210,
      "width": 600,
      "fontSize": 36,
      "fontFamily": "{nameFont}",
      "fontWeight": "bold",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "has-completed",
      "type": "text",
      "content": "has successfully completed the training program",
      "x": 396,
      "y": 270,
      "width": 500,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "course-title",
      "type": "dynamic_field",
      "field": "course_title",
      "x": 396,
      "y": 310,
      "width": 600,
      "fontSize": 26,
      "fontFamily": "{titleFont}",
      "fontWeight": "500",
      "fill": "{accentColor}",
      "align": "center"
    },
    {
      "id": "details-row",
      "type": "shape",
      "shape": "rectangle",
      "x": 100,
      "y": 380,
      "width": 592,
      "height": 1,
      "fill": "#e5e7eb"
    },
    {
      "id": "duration-label",
      "type": "text",
      "content": "DURATION",
      "x": 200,
      "y": 405,
      "width": 100,
      "fontSize": 10,
      "fontFamily": "{bodyFont}",
      "fontWeight": "500",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 1
    },
    {
      "id": "duration-value",
      "type": "dynamic_field",
      "field": "course_hours",
      "x": 200,
      "y": 425,
      "width": 100,
      "fontSize": 16,
      "fontFamily": "{bodyFont}",
      "fontWeight": "bold",
      "fill": "{primaryColor}",
      "align": "center",
      "suffix": " hours"
    },
    {
      "id": "date-label",
      "type": "text",
      "content": "DATE COMPLETED",
      "x": 396,
      "y": 405,
      "width": 140,
      "fontSize": 10,
      "fontFamily": "{bodyFont}",
      "fontWeight": "500",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 1
    },
    {
      "id": "completion-date",
      "type": "dynamic_field",
      "field": "completion_date",
      "x": 396,
      "y": 425,
      "width": 140,
      "fontSize": 16,
      "fontFamily": "{bodyFont}",
      "fontWeight": "bold",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "score-label",
      "type": "text",
      "content": "SCORE",
      "x": 592,
      "y": 405,
      "width": 100,
      "fontSize": 10,
      "fontFamily": "{bodyFont}",
      "fontWeight": "500",
      "fill": "{secondaryColor}",
      "align": "center",
      "letterSpacing": 1
    },
    {
      "id": "quiz-score",
      "type": "dynamic_field",
      "field": "quiz_score",
      "x": 592,
      "y": 425,
      "width": 100,
      "fontSize": 16,
      "fontFamily": "{bodyFont}",
      "fontWeight": "bold",
      "fill": "{accentColor}",
      "align": "center",
      "fallback": "N/A"
    },
    {
      "id": "details-row-bottom",
      "type": "shape",
      "shape": "rectangle",
      "x": 100,
      "y": 470,
      "width": 592,
      "height": 1,
      "fill": "#e5e7eb"
    },
    {
      "id": "instructor-line",
      "type": "shape",
      "shape": "line",
      "x": 250,
      "y": 540,
      "width": 150,
      "height": 1,
      "fill": "{secondaryColor}"
    },
    {
      "id": "instructor-name",
      "type": "dynamic_field",
      "field": "instructor_name",
      "x": 325,
      "y": 515,
      "width": 150,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "instructor-label",
      "type": "text",
      "content": "Training Instructor",
      "x": 325,
      "y": 550,
      "width": 150,
      "fontSize": 10,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "cert-line",
      "type": "shape",
      "shape": "line",
      "x": 442,
      "y": 540,
      "width": 150,
      "height": 1,
      "fill": "{secondaryColor}"
    },
    {
      "id": "cert-id",
      "type": "dynamic_field",
      "field": "certificate_id",
      "x": 517,
      "y": 515,
      "width": 150,
      "fontSize": 12,
      "fontFamily": "{bodyFont}",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "cert-label",
      "type": "text",
      "content": "Certificate ID",
      "x": 517,
      "y": 550,
      "width": 150,
      "fontSize": 10,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "qr-code",
      "type": "qr_code",
      "field": "certificate_url",
      "x": 700,
      "y": 510,
      "size": 55,
      "foreground": "{primaryColor}",
      "background": "#ffffff"
    },
    {
      "id": "bottom-bar",
      "type": "shape",
      "shape": "rectangle",
      "x": 0,
      "y": 600,
      "width": 792,
      "height": 12,
      "fill": "{accentColor}"
    }
  ]
}
