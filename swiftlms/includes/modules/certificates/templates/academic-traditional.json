{
  "id": "academic-traditional",
  "name": "Academic Traditional",
  "description": "University-style certificate with formal academic feel",
  "category": "academic",
  "size": {
    "width": 792,
    "height": 612,
    "unit": "pt"
  },
  "orientation": "landscape",
  "background": {
    "type": "color",
    "value": "#fdfcf8"
  },
  "customizable": {
    "primaryColor": "#1e293b",
    "secondaryColor": "#475569",
    "accentColor": "#7c2d12",
    "titleFont": "Libre Baskerville",
    "bodyFont": "Source Serif Pro",
    "nameFont": "Tangerine"
  },
  "elements": [
    {
      "id": "border-outer",
      "type": "shape",
      "shape": "rectangle",
      "x": 25,
      "y": 25,
      "width": 742,
      "height": 562,
      "fill": "transparent",
      "stroke": "{accentColor}",
      "strokeWidth": 2
    },
    {
      "id": "border-inner",
      "type": "shape",
      "shape": "rectangle",
      "x": 35,
      "y": 35,
      "width": 722,
      "height": 542,
      "fill": "transparent",
      "stroke": "{accentColor}",
      "strokeWidth": 1
    },
    {
      "id": "seal-placeholder",
      "type": "image_placeholder",
      "placeholder": "seal",
      "x": 80,
      "y": 70,
      "width": 80,
      "height": 80,
      "description": "Institution Seal"
    },
    {
      "id": "institution-name",
      "type": "text",
      "content": "{site_name}",
      "x": 396,
      "y": 70,
      "width": 500,
      "fontSize": 16,
      "fontFamily": "{titleFont}",
      "fontWeight": "normal",
      "fill": "{accentColor}",
      "align": "center",
      "letterSpacing": 4,
      "textTransform": "uppercase",
      "editable": true
    },
    {
      "id": "title",
      "type": "text",
      "content": "Certificate of Achievement",
      "x": 396,
      "y": 115,
      "width": 600,
      "fontSize": 40,
      "fontFamily": "{titleFont}",
      "fontWeight": "normal",
      "fontStyle": "italic",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "ornament",
      "type": "text",
      "content": "§",
      "x": 396,
      "y": 160,
      "fontSize": 24,
      "fontFamily": "serif",
      "fill": "{accentColor}",
      "align": "center"
    },
    {
      "id": "conferred-upon",
      "type": "text",
      "content": "This is to certify that",
      "x": 396,
      "y": 195,
      "width": 400,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fontStyle": "italic",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "student-name",
      "type": "dynamic_field",
      "field": "student_name",
      "x": 396,
      "y": 245,
      "width": 650,
      "fontSize": 56,
      "fontFamily": "{nameFont}",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "has-completed",
      "type": "text",
      "content": "has satisfactorily completed the requirements for",
      "x": 396,
      "y": 305,
      "width": 500,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fontStyle": "italic",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "course-title",
      "type": "dynamic_field",
      "field": "course_title",
      "x": 396,
      "y": 345,
      "width": 600,
      "fontSize": 24,
      "fontFamily": "{titleFont}",
      "fontWeight": "bold",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "given-this",
      "type": "text",
      "content": "Given this day of",
      "x": 396,
      "y": 400,
      "width": 300,
      "fontSize": 12,
      "fontFamily": "{bodyFont}",
      "fontStyle": "italic",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "completion-date",
      "type": "dynamic_field",
      "field": "completion_date",
      "x": 396,
      "y": 420,
      "width": 300,
      "fontSize": 14,
      "fontFamily": "{bodyFont}",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "sig-line-1",
      "type": "shape",
      "shape": "line",
      "x": 120,
      "y": 510,
      "width": 180,
      "height": 1,
      "fill": "{secondaryColor}"
    },
    {
      "id": "sig-label-1",
      "type": "text",
      "content": "Director of Studies",
      "x": 210,
      "y": 520,
      "width": 180,
      "fontSize": 10,
      "fontFamily": "{bodyFont}",
      "fontStyle": "italic",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "sig-line-2",
      "type": "shape",
      "shape": "line",
      "x": 492,
      "y": 510,
      "width": 180,
      "height": 1,
      "fill": "{secondaryColor}"
    },
    {
      "id": "instructor-name",
      "type": "dynamic_field",
      "field": "instructor_name",
      "x": 582,
      "y": 490,
      "width": 180,
      "fontSize": 14,
      "fontFamily": "{nameFont}",
      "fill": "{primaryColor}",
      "align": "center"
    },
    {
      "id": "sig-label-2",
      "type": "text",
      "content": "Course Instructor",
      "x": 582,
      "y": 520,
      "width": 180,
      "fontSize": 10,
      "fontFamily": "{bodyFont}",
      "fontStyle": "italic",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "cert-id",
      "type": "dynamic_field",
      "field": "certificate_id",
      "x": 396,
      "y": 555,
      "width": 200,
      "fontSize": 9,
      "fontFamily": "{bodyFont}",
      "fill": "{secondaryColor}",
      "align": "center"
    },
    {
      "id": "qr-code",
      "type": "qr_code",
      "field": "certificate_url",
      "x": 680,
      "y": 70,
      "size": 50,
      "foreground": "{accentColor}",
      "background": "#fdfcf8"
    }
  ]
}
